# ==============================================================================
# BRAND HOUSE ERP — Ətraf Mühit Dəyişənləri Konfiqurasiyası (.env.example)
# ==============================================================================

# Əsas Tətbiq Parametrləri
APP_NAME="BRAND HOUSE ERP API"
APP_ENV="development" # development | staging | production | testing
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Təhlükəsizlik və Parollar
SECRET_KEY="change-this-in-production-to-at-least-32-characters-random-secret"
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# Saat Qurşağı və Lokalizasiya
TIMEZONE="Asia/Baku"
DEFAULT_LOCALE="az" # az | en | ru

# PostgreSQL Verilənlər Bazası (PostgreSQL 16)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/brand_house_erp"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Redis (Keş, Kilid və İş Növbəsi)
# Lokal mühitdə boş qoyula bilər; bu halda Redis asılılığı graceful şəkildə qeyri-aktiv olacaq.
REDIS_URL="redis://localhost:6379/0"
REDIS_ENABLED=true

# Idempotency Parametrləri
IDEMPOTENCY_TTL_SECONDS=86400 # 24 saat

# Qlobal Rate Limiting (Dəqiqəlik sorğu sayı)
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10

# ==============================================================================
# ƏLAVƏ İNTEQRASİYALAR (Boş qaldıqda /integrations/status "NOT CONFIGURED" verir)
# ==============================================================================

# Ödəniş Sistemi (Məs: Pasha Bank, Kapital Bank, MPAY)
PAYMENT_PROVIDER=""
PAYMENT_PROVIDER_API_KEY=""
PAYMENT_PROVIDER_MERCHANT_ID=""
PAYMENT_PROVIDER_BASE_URL=""

# SMS Bildiriş Provayderi (Məs: Azercell, Bakcell, Simurq)
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER_NAME=""

# E-Poçt (SMTP)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""

# Fiskal / Şəbəkə Çek Printeri
PRINT_SERVER_URL=""
PRINT_SERVER_API_KEY=""

# Köhnə Brendhouse.az İnteqrasiyası
LEGACY_BRENDHOUSE_API_URL=""
LEGACY_BRENDHOUSE_API_KEY=""

# Telemetriya və Monitorinq (Könüllü)
SENTRY_DSN=""
OPENTELEMETRY_ENDPOINT=""

