# BRAND HOUSE ERP — Environment Variables

# Application Name
VITE_APP_NAME="BRAND HOUSE ERP"

# Data Source Adapter: "mock" (in-memory realistic seed) or "http" (REST API)
VITE_DATA_SOURCE="mock"

# API Base URL (used when VITE_DATA_SOURCE=http)
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Default Locale: "az" | "en" | "ru"
VITE_DEFAULT_LOCALE="az"

# Currency Code & Timezone
VITE_CURRENCY="AZN"
VITE_TIMEZONE="Asia/Baku"

# Brand Accent Color (placeholder: #111111 until official HEX is confirmed)
VITE_BRAND_ACCENT="#111111"

# Simulated Mock Latency in milliseconds
VITE_MOCK_LATENCY_MS="350"

